{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/checkins",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/reassign-flags",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/family-digest",
      "schedule": "0 4 * * 1"
    },
    {
      "path": "/api/cron/refill-reminders",
      "schedule": "0 5 * * *"
    }
  ]
}
