PORT=5000
DATABASE_URL=postgres://user:password@localhost:5432/sehat_saathi
REDIS_URL=redis://127.0.0.1:6379
ANTHROPIC_API_KEY=your_anthropic_api_key_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token
JWT_SECRET=replace_with_a_long_random_string
# Only needed on the Vercel deployment — Vercel Cron sends this automatically
# as a Bearer header once set in the project's env vars. Any long random string.
CRON_SECRET=replace_with_a_long_random_string

# --- Multi-hospital (Super Admin) ---
# Used once by backend/scripts/seed-super-admin.js to bootstrap the first
# super_admin account (there's no public signup for this role).
SUPER_ADMIN_PHONE=9999999999
SUPER_ADMIN_PASSWORD=replace_with_a_strong_temp_password
# WHATSAPP_ACCESS_TOKEN / WHATSAPP_PHONE_NUMBER_ID above now act as the
# fallback used when a clinic row has no whatsapp_access_token /
# whatsapp_phone_number_id of its own (single-clinic / local dev). Once a
# clinic is onboarded with its own WABA number via POST /api/clinics, those
# per-clinic values take priority.

# --- QR self-enrollment: Azure Speech-to-Text (voice note doctor ID) ---
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=your_azure_speech_region
