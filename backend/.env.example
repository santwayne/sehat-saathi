PORT=5000
DATABASE_URL=postgres://user:password@localhost:5432/sehat_saathi
REDIS_URL=redis://127.0.0.1:6379
ANTHROPIC_API_KEY=your_anthropic_api_key_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token
JWT_SECRET=replace_with_a_long_random_string
# Encrypts third-party keys saved from Super Admin → Integrations (AES-256-GCM).
# Falls back to JWT_SECRET when unset. Changing it makes saved keys unreadable
# (they then need re-entering), so set it once and keep it.
INTEGRATIONS_ENCRYPTION_KEY=replace_with_a_different_long_random_string
# Only needed on the Vercel deployment — Vercel Cron sends this automatically
# as a Bearer header once set in the project's env vars. Any long random string.
CRON_SECRET=replace_with_a_long_random_string

# --- Multi-hospital (Super Admin) ---
# Used once by backend/scripts/seed-super-admin.js to bootstrap the first
# super_admin account (there's no public signup for this role).
SUPER_ADMIN_PHONE=9999999999
SUPER_ADMIN_PASSWORD=replace_with_a_strong_temp_password
# WHATSAPP_ACCESS_TOKEN / WHATSAPP_PHONE_NUMBER_ID above now act as the
# fallback used when a clinic row has no whatsapp_access_token /
# whatsapp_phone_number_id of its own (single-clinic / local dev). Once a
# clinic is onboarded with its own WABA number via POST /api/clinics, those
# per-clinic values take priority.

# --- QR self-enrollment: Azure Speech-to-Text (voice note doctor ID) ---
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=your_azure_speech_region

# --- ABHA creation via ABDM (optional; off when unset) ---
# ABDM must enable v3 ABHA (hid role) access on the client id. URLs default to
# the sandbox; override ABDM_SESSION_URL / ABDM_ABHA_BASE_URL / ABDM_CERT_URL if
# ABDM's paths differ, and set ABDM_CM_ID=abdm for production.
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_CM_ID=sbx

# --- Voice check-in calls via Twilio (optional; off when unset) ---
# PUBLIC_BASE_URL must be this API's public URL — Twilio signatures are
# verified against it. Optional per-language voice override: TWILIO_VOICE_HI=...
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VOICE_NUMBER=+1XXXXXXXXXX
PUBLIC_BASE_URL=https://your-api.example.com

# --- Regulars (retention platform) integration (optional; off when unset) ---
# Base URL of the Regulars app, e.g. https://regulars.wayneesolutions.com.
# Can also be set from Super Admin → Integrations. Each hospital's Regulars
# API key is entered per hospital there (never in env).
REGULARS_BASE_URL=

# --- AI model (optional) ---
# Default claude-sonnet-5. Change here when moving to a newer Claude model; no code change needed.
ANTHROPIC_MODEL=

# --- Loopdesk hub (Sehat Saathi as a Loopdesk hospital package) — docs/loopdesk-hub.md ---
# Same value as HUB_SECRET_SEHAT_SAATHI on the Loopdesk hub (openssl rand -hex 32; 32+ chars).
HUB_SECRET=
# Loopdesk hub address. Set = Loopdesk hospitals' WhatsApp goes out from their Loopdesk number.
HUB_API_URL=https://app.loopdeskai.wayneesolutions.com
# Dashboard address, used in the link Loopdesk shows after set-up.
APP_BASE_URL=
